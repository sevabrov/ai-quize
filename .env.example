# ── API (json-server) ────────────────────────────────────────────────
# Порожнє значення = статичний режим: бекенду немає, запити не виконуються,
# прогрес живе в localStorage, результати - лише в Google Таблиці.
# Саме так збирається демо для GitHub Pages (див. docs/deploy.md).
VITE_API_URL=http://localhost:3001

# ── Google Таблиця (Apps Script Web App) ─────────────────────────────
# Як отримати - docs/google-sheets.md. Порожнє = запис вимкнено.
VITE_SHEETS_URL=
VITE_SHEETS_SECRET=

# ── Партнерське посилання MIHI ───────────────────────────────────────
VITE_MIHI_URL=https://mihi.care/ua/a-79-mihi-the-business-of-a-new-era?referral_code=100001

# ── Таймінги сценарію (мс) ───────────────────────────────────────────
# Продакшн: 180000 = 3 хвилини (за ТЗ)
VITE_ANALYSIS_DELAY_MS=180000
VITE_BOOKING_NUDGE_DELAY_MS=180000

# Для демо замовнику, щоб не чекати по 3 хвилини, розкоментуй:
# VITE_ANALYSIS_DELAY_MS=8000
# VITE_BOOKING_NUDGE_DELAY_MS=8000
